# Copy this file to .env and fill in real values
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# PostgreSQL in Docker (docker compose up -d). Remove this line to use SQLite instead.
DATABASE_URL=postgres://sos:sos_dev_password@localhost:5433/sos

# Redis in Docker, used by Celery for background tasks
REDIS_URL=redis://localhost:6380/0

# ---- Abuse protection ----
LLM_DAILY_CALL_LIMIT=150      # max Groq calls per day; afterwards the rule/extractive fallbacks answer
DEMO_MODE=0                   # 1 = public demo: no sign-up, SOS rate-limited, old incidents auto-deleted
DEMO_RETENTION_HOURS=24

# ---- Telegram alerts (optional, free) ----
# Create a bot with @BotFather, then: python manage.py telegram_webhook https://<public-url>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=      # random letters/digits/_/- only, 1-256 chars
# SITE_URL=https://community-sos-07io.onrender.com   # used for links inside alerts

# ---- Production (public server) ----
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<long random string>
# DJANGO_ALLOWED_HOSTS=community-sos.example.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://community-sos.example.org
